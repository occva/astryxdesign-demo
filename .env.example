VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_API_BASE_URL=/api

# NestJS only. Never expose this value through a VITE_ variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Supabase CLI / PostgreSQL maintenance only. Never expose this to the browser.
SUPABASE_DB_PASSWORD=your-database-password
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Single-instance authentication abuse protection. Keep enabled unless a trusted shared gateway replaces it.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_IP_RATE_LIMIT=100
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_IP_RATE_LIMIT=20
AUTH_REFRESH_RATE_LIMIT=60

# One-time Supabase Auth account provisioning. Keep disabled during normal runtime.
ALLOW_AUTH_ACCOUNT_PROVISIONING=false
AUTH_ACCOUNT_PROJECT_REF=your-project
AUTH_ACCOUNTS=admin
AUTH_ACCOUNT_PASSWORD=replace-with-a-strong-password
